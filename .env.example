# Hugging Face Model Identifier (e.g. Qwen/Qwen2.5-7B-Instruct, meta-llama/Meta-Llama-3.1-8B-Instruct)
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Optional: Hugging Face User Access Token (Required for gated models like Llama 3)
HF_TOKEN=

# GPU Memory utilization ratio (0.0 to 1.0)
GPU_MEMORY_UTILIZATION=0.90

# Maximum model context length (in tokens)
MAX_MODEL_LEN=4096

# Number of GPUs to split the model across (tensor parallelism)
TENSOR_PARALLEL_SIZE=1

# Host port mapping for OpenAI-compatible HTTP API (vLLM container)
PORT=8000

# Host port mapping for Open WebUI chat frontend
OPEN_WEBUI_PORT=3000

# Local directory path to cache downloaded Hugging Face models
HF_CACHE_DIR=~/.cache/huggingface
